sequenceDiagram
    autonumber
    actor U as User/Browser
    participant FE as Frontend
    participant BE as Backend
    participant GL as GitLab API

    U->>FE: Klick "Zum Review freigeben"
    FE->>BE: POST /workspaces/review { repo, branch, target="main", title?, description?, reviewers?, labels?, ready=true }
    BE->>BE: app_token prüfen -> gitlab_access_token

    BE->>GL: GET /projects/:id/merge_requests?state=opened&sourceBranch=<branch>&targetBranch=<target>
    GL-->>BE: [ ... ] oder []

    alt MR existiert
        opt ready==true
            BE->>GL: PUT /projects/:id/merge_requests/:iid { remove_wip: true }  <!-- "Draft" entfernen -->
            GL-->>BE: { id, webUrl, ... }
        end
        BE-->>FE: 200 { id, webUrl, state, sourceBranch, targetBranch }
    else Neuer MR
        BE->>GL: POST /projects/:id/merge_requests { sourceBranch, targetBranch, title, description, remove_sourceBranch=false, squash=true, labels }
        GL-->>BE: { id, webUrl, ... }

        opt reviewers angegeben
            BE->>GL: PUT /projects/:id/merge_requests/:id { reviewer_ids:[...] }
            GL-->>BE: { id, reviewers:[...] }
        end

        opt ready==true (falls Titel mit "Draft: " kam)
            BE->>GL: PUT /projects/:id/merge_requests/:id { remove_wip: true }
            GL-->>BE: { ... }
        end

        BE-->>FE: 201 { id, webUrl, state, sourceBranch, targetBranch }
    end
